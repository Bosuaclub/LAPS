# Streamlit Cloud Secrets Example
# Copy this to secrets.toml and fill in your values
# DO NOT commit secrets.toml to git!

# Google Gemini API (Required for embeddings and LLM)
GOOGLE_API_KEY = "AIza..."

[anthropic]
api_key = "sk-ant-..."

# Optional: Facebook API (for future integration)
[facebook]
app_id = "your_fb_app_id"
app_secret = "your_fb_app_secret"
access_token = "your_access_token"
